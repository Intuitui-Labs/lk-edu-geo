{
  "name": "@intuitui-labs/lk-edu-geo",
  "version": "1.0.2",
  "description": "Sri Lanka educational zones, districts, provinces, and GN divisions open dataset and validation engine.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "data",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./data/*": "./data/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:artifact": "vitest run test/dist-artifact.test.ts",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('node_modules',{recursive:true,force:true})\"",
    "prepublishOnly": "pnpm run check-types && pnpm run build && pnpm run test"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intuitui-labs/lk-edu-geo.git"
  },
  "keywords": [
    "sri-lanka",
    "lk",
    "education",
    "geo",
    "schools",
    "districts",
    "provinces",
    "gn-divisions",
    "educational-zones"
  ],
  "author": "Intuitui Labs & Neev Foundation",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "7.0.2",
    "vitest": "^5.0.3"
  }
}
